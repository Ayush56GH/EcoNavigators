# ============================================================
# .env.example - Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# Rotate any credentials that were previously committed.
# ============================================================

# ---- Copernicus Data Space (Sentinel Hub) ----
COPERNICUS_CLIENT_ID=YOUR_COPERNICUS_CLIENT_ID_HERE
COPERNICUS_CLIENT_SECRET=YOUR_COPERNICUS_CLIENT_SECRET_HERE

# ---- AIS Stream ----
AISSTREAM_API_KEY=YOUR_AISSTREAM_API_KEY_HERE

# ---- MarineTraffic (optional) ----
MARINETRAFFIC_API_KEY=YOUR_MARINETRAFFIC_API_KEY_HERE

# ---- PostgreSQL / Supabase ----
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

# ---- AIS Monitoring Region ----
AIS_MIN_LAT=4.00
AIS_MAX_LAT=24.00
AIS_MIN_LON=61.00
AIS_MAX_LON=92.00
AIS_CIRCLE_RADIUS_KM=50
AIS_POLL_SECONDS=300

# ---- CORS allowed origins (comma-separated) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- SAR Processing Thresholds ----
SAR_SEARCH_WINDOW_HOURS=24
SAR_ASSOCIATION_WINDOW_MINUTES=120
SAR_SEGMENTATION_THRESHOLD=0.45
MAX_FUSION_DISTANCE_KM=25.0
MAX_FUSION_TIME_MINUTES=120.0
